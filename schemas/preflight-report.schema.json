{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postex.dev/schemas/v0.4/preflight-report.schema.json",
  "title": "PostEx Preflight Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "passed", "release_ready", "output_status", "findings"],
  "properties": {
    "schema_version": {"const": "0.4"},
    "project_id": {"type": "string"},
    "poster_size": {"enum": ["a0-landscape", "a1-landscape", "36x48-landscape"]},
    "expected_inches": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "minItems": 2,
      "maxItems": 2
    },
    "passed": {"type": "boolean"},
    "release_ready": {"type": "boolean"},
    "output_status": {"enum": ["draft", "release-ready"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "passed", "message"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["info", "warning", "error"]},
          "passed": {"type": "boolean"},
          "message": {"type": "string"},
          "location": {"type": ["string", "null"]},
          "remediation": {"type": ["string", "null"]}
        }
      }
    }
  }
}
